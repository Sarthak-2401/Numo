# ============================================
# Numo - Environment Variables
# ============================================

# Database
POSTGRES_USER=numo
POSTGRES_PASSWORD=numo_secret_2026
POSTGRES_DB=numo_db
DATABASE_URL=postgresql://numo:numo_secret_2026@postgres:5432/numo_db

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=numo-local-development-key
JWT_EXPIRES_IN=7d

# Twilio Verify (SMS sign-in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SMTP
SMTP_DOMAIN=numo.local
SMTP_PORT=25

# Backend
BACKEND_PORT=4000
NODE_ENV=development

# Web Client
VITE_API_URL=http://localhost:4000/api
