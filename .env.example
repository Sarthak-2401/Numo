# ============================================
# Numo - Environment Variables
# ============================================

# Database
POSTGRES_USER=numo
POSTGRES_PASSWORD=numo_secret_2026
POSTGRES_DB=numo_db
DATABASE_URL=postgresql://numo:numo_secret_2026@postgres:5432/numo_db

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=numo-local-development-key

# Twilio Verify (SMS sign-in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SMTP
SMTP_DOMAIN=numo.local
SMTP_PORT=25
EXTERNAL_SMTP_USER=
EXTERNAL_SMTP_PASS=
# Local account email testing only. Use mailpit with the mail-testing Compose profile.
RECOVERY_TEST_SMTP_HOST=

# Backend
BACKEND_PORT=4000
NODE_ENV=development

# Web Client
APP_PUBLIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000/api
